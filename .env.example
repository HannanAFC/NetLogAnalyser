# Environment variables used by docker
POSTGRES_USER=NetlogAnalyserUser
POSTGRES_PASSWORD=NetLogAnalyserPass
POSTGRES_DB=NetLogAnalyserDB

# Environment variables shared across the application
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
BUILD_MODE=development

# Environment variables used by the backend
APP_NAME=NetLogAnalyserDev
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://NetlogAnalyserUser:NetLogAnalyserPass@db/NetLogAnalyserDB

SECRET_KEY=A-SECRET-KEY
ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=5

CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

API_KEY_PREFIX_LENGTH=8
API_KEY_MAX_PER_USER=10

INGEST_MAX_SIZE=500

WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS_PER_USER=5

COOKIE_SECURE=TRUE
COOKIE_SAMESITE=lax

UV_LINK_MODE=copy

REDIS_URL=redis://NetlogAnalyserUser:NetLogAnalyserPass@redis:6379

# Environment variables used by the frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/ws