# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Docker image
IMAGE_TAG=latest

# Postgres
POSTGRES_USER=netloganalyser
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=netloganalyser

# App metadata
APP_NAME=NetLogAnalyser
ENVIRONMENT=production

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Databases
DATABASE_URL=postgresql+psycopg://netloganalyser:__GENERATE__@db:5432/netloganalyser
GEOIP_DB_PATH=shared/geoip/GeoLite2-Country.mmdb

# Auth
SECRET_KEY=__GENERATE__
ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=5

# CORS
CORS_ALLOWED_ORIGINS=[]

# API keys
API_KEY_PREFIX_LENGTH=8
API_KEY_MAX_PER_USER=10

# Ingest
INGEST_MAX_BATCH_SIZE=500

# Websocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS_PER_USER=5
WS_TICKET_TTL_SECONDS=30
WS_STALE_CONNECTION_SECONDS=90

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Redis
REDIS_URL=redis://redis:6379

# Rate limits
RATELIMIT_AUTH_TIMES=10
RATELIMIT_AUTH_SECONDS=60
RATELIMIT_FORGOT_PASSWORD_TIMES=3
RATELIMIT_FORGOT_PASSWORD_SECONDS=60
RATELIMIT_INGEST_TIMES=1000
RATELIMIT_INGEST_SECONDS=60
RATELIMIT_WS_TIMES=50
RATELIMIT_WS_SECONDS=60
RATELIMIT_GENERAL_TIMES=100
RATELIMIT_GENERAL_SECONDS=60

# Email service
EMAIL_VERIFICATION_ENABLED=false
RESEND_API_KEY=
RESEND_ONBOARDING_EMAIL=NetLogAnalyser <onboarding@netloganalyser.com>
RESEND_VERIFY_EMAIL=NetLogAnalyser <verify@netloganalyser.com>
RESEND_RECOVERY_EMAIL=NetLogAnalyser <recovery@netloganalyser.com>
RESEND_GENERAL_EMAIL=NetLogAnalyser <robot@netloganalyser.com>
SUPPORT_EMAIL=support@netloganalyser.com
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=60

# Testing only endpoints
ENABLE_TEST_ENDPOINTS=false
TEST_ENDPOINT_KEY=
TEST_EMAIL_DOMAIN=@example.com

# Anomaly detectio
ANOMALY_PACKET_SIZE_MTU=1500
ANOMALY_PACKET_SIZE_JUMBO_MAX=9000
ANOMALY_PACKET_SIZE_TINY_MAX=40
ANOMALY_PORT_SCAN_LOW=5
ANOMALY_PORT_SCAN_HIGH=25
ANOMALY_HOST_SWEEP_LOW=5
ANOMALY_HOST_SWEEP_HIGH=20
ANOMALY_WEIGHT_PACKET_SIZE=0.5
ANOMALY_WEIGHT_TCP_FLAGS=0.9
ANOMALY_WEIGHT_MISMATCH_PORTS=0.6
ANOMALY_WEIGHT_PORT_SCAN_SHAPE=0.7
ANOMALY_WEIGHT_HOST_SWEEP_SHAPE=0.6

# Analytics
ANALYTICS_MAX_RANGE_DAYS=30
ANALYTICS_SUMMARY_EXPIRE_SECONDS=30
ANALYTICS_TIMESERIES_EXPIRE_SECONDS=30

# Data retention
RETENTION_ENABLED=true
RETENTION_DAYS=30
RETENTION_GRACE_PERIOD_DAYS=7
RETENTION_EXPORT_EMAIL_ENABLED=true
RETENTION_DELETE_CHUNK_SIZE=5000
RETENTION_JOB_LOCK_TTL_SECONDS=30

# Export storage
EXPORT_STORAGE_BACKEND=local
EXPORT_LOCAL_PATH=data/exports

EXPORT_S3_BUCKET=
EXPORT_S3_ENDPOINT_URL=
EXPORT_S3_REGION=
EXPORT_S3_ACCESS_KEY_ID=
EXPORT_S3_SECRET_ACCESS_KEY=
EXPORT_LINK_TTL_HOURS=72
EXPORT_MAX_PER_USER_PER_DAY=3
EXPORT_AUTHENTICATED_LINK_TTL_SECONDS=300

# GeoLite
# Free account: https://www.maxmind.com/en/geolite2/signup
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
GEOIPUPDATE_EDITION_IDS=GeoLite2-ASN GeoLite2-City GeoLite2-Country

# UV
UV_LINK_MODE=copy
