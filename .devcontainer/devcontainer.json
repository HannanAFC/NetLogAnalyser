// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/postgres
{
	"name": "Python 3, PostgreSQL & Node for NetLogAnalyser",
	"dockerComposeFile": "../docker-compose.yml",
	"service": "devcontainer",
	"workspaceFolder": "/workspaces",

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// This can be used to network with other containers or the host.
	// "forwardPorts": [ 5173, 5432, 8000 ],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"bradlc.vscode-tailwindcss",
				"stivo.tailwind-fold",
				"ReprEng.csv",
				"FastAPILabs.fastapi-vscode",
				"msjsdiag.vscode-react-native",
				"ms-python.python"
			],
			"settings": {
				"editor.indentSize": "tabSize",
				"editor.tabSize": 4,
				"chat.disableAIFeatures": true,
				"python.defaultInterpreterPath": "/workspaces/backend/.venv/bin/python"
			}
		}
	},
	"mounts": [
		"source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind"
	],
	"postCreateCommand": "git config --global --add safe.directory /workspaces && cd /workspaces/backend && poetry install --no-interaction"

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
