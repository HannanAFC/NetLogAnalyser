{
  "name": "frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "node scripts/generate-config.mjs --out public/config.js && vite",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:render": "vite build && node scripts/generate-config.mjs --out dist/config.js",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:integration": "RUN_INTEGRATION_TESTS=1 vitest run --project integration",
    "test:all": "vitest run",
    "check": "npx tsc --noEmit",
    "lint": "eslint",
    "format": "eslint --fix"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts": "^0.15.0",
    "@tanstack/charts-scales": "^0.15.0",
    "@tanstack/react-charts": "^0.15.0",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-query": "^5.102.5",
    "@tanstack/react-query-devtools": "^5.102.5",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-table-devtools": "^9.2.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@tanstack/router-plugin": "^1.168.35",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-simple-maps": "^3.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/eslint-plugin-query": "^5.102.5",
    "@tanstack/router-cli": "^1.167.33",
    "@tanstack/router-plugin": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-simple-maps": "^3.0.6",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}